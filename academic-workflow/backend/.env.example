# ── Backend Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values before deploying.

# Database (Railway/Render auto-set this for PostgreSQL. Leave blank for local SQLite.)
DATABASE_URL=

# Google Gemini API Key (required for AI task generation and auditing)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (change this to a long, random string in production!)
SECRET_KEY=change_me_to_a_long_random_secret_in_production
