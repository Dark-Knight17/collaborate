# ── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# For local development, leave VITE_API_URL blank (defaults to localhost:8000).
# For production (Vercel), set VITE_API_URL to your deployed backend URL.

# Example:
# VITE_API_URL=https://collaborate-backend.railway.app/api
VITE_API_URL=
